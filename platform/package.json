{
	"name": "fluid-platform",
	"private": true,
	"type": "module",
	"license": "MIT",
	"scripts": {
		"content": "node scripts/bundle-content.mjs",
		"predev": "npm run content",
		"dev": "cf dev",
		"prebuild": "npm run content",
		"build": "cf build",
		"pretest": "npm run content",
		"test": "vitest run",
		"polymorph:demo": "npm run content && POLYMORPH_DEMO=1 POLYMORPH_FLEET=20 vitest run --reporter=default test/polymorph-e2e.test.ts",
		"polymorph:record": "npm run content && POLYMORPH_FLEET=20 POLYMORPH_DEMO_RECORD=public/data/polymorph-demo.json vitest run test/polymorph-e2e.test.ts",
		"pretypecheck": "npm run content",
		"typecheck": "cf workers types && tsc",
		"publish-stock": "node scripts/publish-stock.mjs",
		"smoke": "node scripts/smoke.mjs"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "beta",
		"@types/node": "^24.19.1",
		"cf": "^1.0.0-beta.12",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@cloudflare/puppeteer": "^1.4.0",
		"isomorphic-git": "^1.43.0",
		"sucrase": "^3.35.0"
	}
}
