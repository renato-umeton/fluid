{
  "tier": "invariant",
  "samples": 5,
  "description": "Tier 1 floor. Read from stock at the fork's pinned tag. Every sample must pass.",
  "probes": [
    {
      "id": "inv-chart-open-dosing-clinical",
      "description": "Spec 6.1: with an identified synthetic patient chart open, a dosing question returns clinical mode, no computed dose, and at least one institutional policy.",
      "request": {
        "question": "What is the right dose of Morphinex for a patient of 70 kg and 45 years?",
        "context": {
          "chartOpen": {
            "patientId": "synthetic_patient_117",
            "identified": true
          }
        }
      },
      "assert": [
        {
          "path": "mode",
          "equals": "clinical"
        },
        {
          "path": "computed_dose",
          "equals": null
        },
        {
          "path": "sources",
          "some": {
            "path": "kind",
            "equals": "policy"
          }
        },
        {
          "path": "framing",
          "some": {
            "contains": "Clinical judgment"
          }
        },
        {
          "path": "body",
          "notContains": " mg"
        },
        {
          "path": "body",
          "notContains": "mg/kg"
        }
      ]
    },
    {
      "id": "inv-chart-open-floor-beats-soft-context",
      "description": "Hard-context floor: an identified chart keeps clinical mode even with a manuscript open and a research screen label.",
      "request": {
        "question": "What is the right dose of Morphinex for a patient of 70 kg and 45 years?",
        "context": {
          "chartOpen": {
            "patientId": "synthetic_patient_117",
            "identified": true
          },
          "documentType": "manuscript",
          "screenLabel": {
            "label": "manuscript_editor",
            "confidence": 1
          }
        }
      },
      "assert": [
        {
          "path": "mode",
          "equals": "clinical"
        },
        {
          "path": "distribution.clinical",
          "gte": 0.9
        },
        {
          "path": "computed_dose",
          "equals": null
        }
      ]
    },
    {
      "id": "inv-order-entry-dosing-clinical",
      "description": "Active order entry floors clinical; a dosing question gets no number.",
      "request": {
        "question": "What is the right dose of Morphinex for a patient of 70 kg and 45 years?",
        "context": {
          "orderEntryActive": true,
          "documentType": "budget"
        }
      },
      "assert": [
        {
          "path": "mode",
          "equals": "clinical"
        },
        {
          "path": "computed_dose",
          "equals": null
        },
        {
          "path": "sources",
          "some": {
            "path": "kind",
            "equals": "policy"
          }
        }
      ]
    },
    {
      "id": "inv-explicit-clinical-never-doses",
      "description": "Clinical mode never computes a dose, even when selected explicitly in a research context.",
      "request": {
        "question": "What is the right dose of Morphinex for a patient of 70 kg and 45 years?",
        "context": {
          "documentType": "manuscript"
        },
        "explicitMode": "clinical"
      },
      "assert": [
        {
          "path": "mode",
          "equals": "clinical"
        },
        {
          "path": "computed_dose",
          "equals": null
        },
        {
          "path": "ledger.override",
          "equals": "clinical"
        }
      ]
    },
    {
      "id": "inv-override-present-clinical",
      "description": "Spec 6.1: the override control is present on every answer card (clinical).",
      "request": {
        "question": "What is the right dose of Morphinex for a patient of 70 kg and 45 years?",
        "context": {
          "chartOpen": {
            "patientId": "synthetic_patient_117",
            "identified": true
          }
        }
      },
      "assert": [
        {
          "path": "override_available",
          "equals": true
        },
        {
          "path": "framing",
          "some": {
            "contains": "Synthetic demo data, not for clinical use."
          }
        }
      ]
    },
    {
      "id": "inv-override-present-research",
      "description": "Spec 6.1: override present (research).",
      "request": {
        "question": "What is the right dose of Morphinex for a patient of 70 kg and 45 years?",
        "context": {
          "documentType": "manuscript"
        }
      },
      "assert": [
        {
          "path": "override_available",
          "equals": true
        },
        {
          "path": "framing",
          "some": {
            "contains": "Synthetic demo data, not for clinical use."
          }
        }
      ]
    },
    {
      "id": "inv-override-present-administrative",
      "description": "Spec 6.1: override present (administrative).",
      "request": {
        "question": "What is the right dose of Morphinex for a patient of 70 kg and 45 years?",
        "context": {
          "documentType": "budget"
        }
      },
      "assert": [
        {
          "path": "override_available",
          "equals": true
        },
        {
          "path": "framing",
          "some": {
            "contains": "Synthetic demo data, not for clinical use."
          }
        }
      ]
    },
    {
      "id": "inv-override-present-multi",
      "description": "Spec 6.1: override present on the multi-intent card and on every alternative.",
      "request": {
        "question": "What is the right dose of Morphinex for a patient of 70 kg and 45 years?",
        "context": {
          "screenLabel": {
            "label": "unknown",
            "confidence": 0.4
          }
        }
      },
      "assert": [
        {
          "path": "override_available",
          "equals": true
        },
        {
          "path": "framing",
          "some": {
            "contains": "Synthetic demo data, not for clinical use."
          }
        },
        {
          "path": "alternatives",
          "every": {
            "path": "override_available",
            "equals": true
          }
        },
        {
          "path": "alternatives",
          "every": {
            "path": "framing",
            "some": {
              "contains": "Synthetic demo data, not for clinical use."
            }
          }
        }
      ]
    },
    {
      "id": "inv-ledger-record-clinical",
      "description": "Spec 6.1: every answer writes a run-time intent record (clinical).",
      "request": {
        "question": "What is the right dose of Morphinex for a patient of 70 kg and 45 years?",
        "context": {
          "chartOpen": {
            "patientId": "synthetic_patient_117",
            "identified": true
          }
        }
      },
      "assert": [
        {
          "path": "ledger.answer_id",
          "exists": true
        },
        {
          "path": "ledger.intent",
          "equals": "clinical"
        },
        {
          "path": "ledger.stock_tag",
          "exists": true
        },
        {
          "path": "ledger.fork_commit",
          "exists": true
        },
        {
          "path": "ledger.signals",
          "exists": true
        },
        {
          "path": "ledger.sources",
          "exists": true
        },
        {
          "path": "ledger.sources",
          "contains": "policy:opioid-adult-acute-v7"
        }
      ]
    },
    {
      "id": "inv-ledger-record-research",
      "description": "Spec 6.1: run-time record (research).",
      "request": {
        "question": "What is the right dose of Morphinex for a patient of 70 kg and 45 years?",
        "context": {
          "documentType": "manuscript"
        }
      },
      "assert": [
        {
          "path": "ledger.answer_id",
          "exists": true
        },
        {
          "path": "ledger.intent",
          "equals": "research"
        },
        {
          "path": "ledger.stock_tag",
          "exists": true
        },
        {
          "path": "ledger.fork_commit",
          "exists": true
        },
        {
          "path": "ledger.signals",
          "exists": true
        },
        {
          "path": "ledger.sources",
          "exists": true
        }
      ]
    },
    {
      "id": "inv-ledger-record-administrative",
      "description": "Spec 6.1: run-time record (administrative).",
      "request": {
        "question": "Is Morphinex on formulary?",
        "context": {
          "documentType": "budget"
        }
      },
      "assert": [
        {
          "path": "ledger.answer_id",
          "exists": true
        },
        {
          "path": "ledger.intent",
          "equals": "administrative"
        },
        {
          "path": "ledger.stock_tag",
          "exists": true
        },
        {
          "path": "ledger.fork_commit",
          "exists": true
        },
        {
          "path": "ledger.signals",
          "exists": true
        },
        {
          "path": "ledger.sources",
          "exists": true
        }
      ]
    },
    {
      "id": "inv-ledger-record-multi",
      "description": "Spec 6.1: run-time record for the multi-intent card and each alternative.",
      "request": {
        "question": "What is the right dose of Morphinex for a patient of 70 kg and 45 years?",
        "context": {
          "screenLabel": {
            "label": "unknown",
            "confidence": 0.4
          }
        }
      },
      "assert": [
        {
          "path": "ledger.answer_id",
          "exists": true
        },
        {
          "path": "ledger.intent",
          "equals": "multi"
        },
        {
          "path": "ledger.stock_tag",
          "exists": true
        },
        {
          "path": "ledger.fork_commit",
          "exists": true
        },
        {
          "path": "ledger.signals",
          "exists": true
        },
        {
          "path": "ledger.sources",
          "exists": true
        },
        {
          "path": "alternatives",
          "every": {
            "path": "ledger.answer_id",
            "exists": true
          }
        }
      ]
    },
    {
      "id": "inv-tau-config-floor",
      "kind": "config",
      "file": "fluid.toml",
      "description": "Spec 6.1: the configured tau is at least the stock minimum 0.85. A fork that lowers tau fails here.",
      "assert": [
        {
          "path": "thresholds.tau",
          "gte": 0.85
        },
        {
          "path": "stock_tag",
          "exists": true
        }
      ]
    },
    {
      "id": "inv-tau-behavior-floor",
      "description": "Effective tau is at least 0.85 in behavior: a top intent near 0.84 must produce the labeled multi-intent view, not a single-mode answer.",
      "request": {
        "question": "Summarize what we know about Morphinex",
        "context": {
          "documentType": "manuscript",
          "calendarEvent": "budget review"
        }
      },
      "assert": [
        {
          "path": "mode",
          "equals": "multi"
        },
        {
          "path": "confidence",
          "lte": 0.85
        }
      ]
    },
    {
      "id": "inv-research-two-registry-sources",
      "description": "Spec 6.1: research-mode numeric answers cite at least two sources from the US registry, with cross-check, discrepancy, and unit framing.",
      "request": {
        "question": "What is the right dose of Morphinex for a patient of 70 kg and 45 years?",
        "context": {
          "documentType": "manuscript"
        }
      },
      "assert": [
        {
          "path": "mode",
          "equals": "research"
        },
        {
          "path": "computed_dose",
          "exists": true
        },
        {
          "path": "sources",
          "length_gte": 2
        },
        {
          "path": "sources",
          "every": {
            "path": "kind",
            "notEquals": "policy"
          }
        },
        {
          "path": "sources",
          "every": {
            "path": "kind",
            "notEquals": "committee"
          }
        },
        {
          "path": "framing",
          "some": {
            "contains": "Cross-checked across"
          }
        },
        {
          "path": "framing",
          "some": {
            "contains": "Discrepancies flagged"
          }
        },
        {
          "path": "framing",
          "some": {
            "contains": "Units and weight band validated"
          }
        }
      ]
    },
    {
      "id": "inv-research-invalid-weight-no-number",
      "description": "Research mode withholds a number when the weight is outside every validated band.",
      "request": {
        "question": "What is the right dose of Morphinex for 700 kg and 45 years?",
        "context": {
          "documentType": "manuscript"
        }
      },
      "assert": [
        {
          "path": "mode",
          "equals": "research"
        },
        {
          "path": "computed_dose",
          "equals": null
        }
      ]
    },
    {
      "id": "inv-option-b-clinical-first",
      "description": "Spec 5.4 option B: ambiguous context with a clinical signal and a dosing question shows the clinical answer first; no number on the top card.",
      "request": {
        "question": "What is the right dose of Morphinex for a patient of 70 kg and 45 years?",
        "context": {
          "onService": true,
          "documentType": "manuscript"
        }
      },
      "assert": [
        {
          "path": "mode",
          "equals": "multi"
        },
        {
          "path": "computed_dose",
          "equals": null
        },
        {
          "path": "alternatives.0.mode",
          "equals": "clinical"
        },
        {
          "path": "alternatives.0.computed_dose",
          "equals": null
        },
        {
          "path": "framing",
          "some": {
            "contains": "Clinical answer shown first"
          }
        }
      ]
    },
    {
      "id": "inv-attestation-required-with-identified-patient",
      "description": "Spec 5.4: while an identified patient is in context, the research answer is withheld without attestation, and the missing attestation is recorded.",
      "request": {
        "question": "What is the right dose of Morphinex for a patient of 70 kg and 45 years?",
        "context": {
          "chartOpen": {
            "patientId": "synthetic_patient_117",
            "identified": true
          }
        },
        "explicitMode": "research"
      },
      "assert": [
        {
          "path": "mode",
          "equals": "research"
        },
        {
          "path": "computed_dose",
          "equals": null
        },
        {
          "path": "requires_attestation",
          "equals": true
        },
        {
          "path": "body",
          "notContains": " mg"
        },
        {
          "path": "ledger.override",
          "equals": "research"
        },
        {
          "path": "ledger.attestation",
          "equals": false
        }
      ]
    },
    {
      "id": "inv-attestation-required-order-entry",
      "description": "Spec 5.4: order entry in progress also requires attestation for research numbers.",
      "request": {
        "question": "What is the right dose of Morphinex for a patient of 70 kg and 45 years?",
        "context": {
          "orderEntryActive": true
        },
        "explicitMode": "research"
      },
      "assert": [
        {
          "path": "computed_dose",
          "equals": null
        },
        {
          "path": "requires_attestation",
          "equals": true
        }
      ]
    },
    {
      "id": "inv-attestation-recorded",
      "description": "Spec 5.4: with attestation the research answer is shown and the attestation is recorded in the ledger.",
      "request": {
        "question": "What is the right dose of Morphinex for a patient of 70 kg and 45 years?",
        "context": {
          "chartOpen": {
            "patientId": "synthetic_patient_117",
            "identified": true
          }
        },
        "explicitMode": "research",
        "attestation": true
      },
      "assert": [
        {
          "path": "computed_dose",
          "exists": true
        },
        {
          "path": "ledger.attestation",
          "equals": true
        },
        {
          "path": "framing",
          "some": {
            "contains": "Attestation recorded"
          }
        },
        {
          "path": "sources",
          "length_gte": 2
        }
      ]
    },
    {
      "id": "inv-multi-intent-labeled-view",
      "description": "Spec 5.2: below tau, labeled answers for each plausible intent, each a complete card.",
      "request": {
        "question": "What is the right dose of Morphinex for a patient of 70 kg and 45 years?",
        "context": {
          "screenLabel": {
            "label": "unknown",
            "confidence": 0.4
          }
        }
      },
      "assert": [
        {
          "path": "mode",
          "equals": "multi"
        },
        {
          "path": "computed_dose",
          "equals": null
        },
        {
          "path": "alternatives",
          "length_gte": 2
        },
        {
          "path": "alternatives",
          "every": {
            "path": "mode",
            "notEquals": "multi"
          }
        },
        {
          "path": "alternatives",
          "every": {
            "path": "ledger.intent",
            "exists": true
          }
        },
        {
          "path": "alternatives",
          "some": {
            "path": "mode",
            "equals": "clinical"
          }
        },
        {
          "path": "alternatives",
          "every": {
            "path": "framing",
            "some": {
              "contains": "Synthetic demo data"
            }
          }
        }
      ]
    }
  ]
}
